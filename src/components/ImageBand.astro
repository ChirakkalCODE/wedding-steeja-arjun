---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A full-bleed photograph between two sections.
 *
 * Photos that sit inside a content column read as illustrations in a document.
 * A band is the opposite: the page stops being a column for a moment and the
 * photograph is the whole width of the screen. Used sparingly — two on the
 * page — it is what turns a list of sections into something paced.
 *
 * No parallax, on purpose. A band that drifts against the scroll draws
 * attention to itself as an effect; a still one just is.
 *
 * The photograph is absolutely positioned inside a box whose shape is set by an
 * `aspect-ratio` on the band, so its own intrinsic ratio never sizes anything
 * and the band cannot shift layout as it decodes. The ratio is declared per
 * band rather than picked from a scale, because a 21:9 slice of a portrait and
 * a 16:9 slice of the same frame are different photographs.
 *
 * `focalPoint` is required and has no default, deliberately. Every one of these
 * is a narrow slice of a frame that was shot portrait, so the crop is most of
 * the composition — leaving it at the browser's 50% 50% is how a lantern ends
 * up outside the frame and a couple ends up against the bottom edge. There is
 * no band on this page that has not had that decision made for it.
 */
interface Props {
  image: ImageMetadata;
  alt: string;
  /** Present ⇒ a warm gradient is laid over the photo to carry the words. */
  quote?: string;
  attribution?: string;
  /** `aspect-ratio` for the band box, e.g. `'16 / 9'`. */
  ratio: string;
  /** Optional replacement below 900px, for a crop that cannot survive the wide
      one — a tall slice keeps what a letterbox would cut off. */
  ratioNarrow?: string;
  /** `object-position` for the crop. Required; see the note above. */
  focalPoint: string;
  /** Optional `filter` on the photo. Some of these frames were exposed for one
      lamp in the dark and arrive on screen closer to black than to a picture. */
  lift?: string;
}

const { image, alt, quote, attribution, ratio, ratioNarrow, focalPoint, lift } = Astro.props;

const bandStyle = [
  `--band-ratio:${ratio}`,
  ratioNarrow && `--band-ratio-narrow:${ratioNarrow}`,
]
  .filter(Boolean)
  .join(';');

const photoStyle = [`object-position:${focalPoint}`, lift && `filter:${lift}`]
  .filter(Boolean)
  .join(';');
---

<figure class="band" style={bandStyle}>
  {/* Full-bleed: `sizes="100vw"` is exact, because the box is the width of the
      viewport and the photo covers it. Deliberately not `100vw` plus a negative
      margin breakout — the bands are direct children of <main>, which sets no
      width, so they are already edge to edge, and the breakout trick overflows
      by the width of the scrollbar on every desktop that has one. */}
  <Picture
    class="band__photo"
    src={image}
    formats={['avif', 'webp']}
    widths={[640, 960, 1400, 1920]}
    width={1920}
    sizes="100vw"
    alt={alt}
    loading="lazy"
    decoding="async"
    style={photoStyle}
    data-anim="img"
  />

  {quote && <div class="band__scrim" aria-hidden="true" />}

  {
    quote && (
      <figcaption class="band__caption">
        <blockquote class="band__quote">{quote}</blockquote>
        {attribution && <p class="band__attribution">{attribution}</p>}
      </figcaption>
    )
  }
</figure>

<style>
  .band {
    position: relative;
    display: grid;
    /* Same max-content trap the hero guards against: an implicit `auto` column
       is sized to the longest unwrapped line and would push the quote off the
       side of a phone rather than wrapping it. */
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    width: 100%;
    aspect-ratio: var(--band-ratio);
    /* The ratio decides the height, except where a caption would not fit inside
       it — a band is a photograph, not a box that clips words. */
    min-height: min-content;
    margin: 0;
    overflow: hidden;
    isolation: isolate;
    /* Behind the photograph while it decodes. Both bands are dark black and
       white frames, so the warm dark is the right holding colour. */
    background-color: var(--color-ink);
    color: var(--color-shell);
  }

  /* 900px is where a letterbox stops being a letterbox and starts being a
     stripe: below it a 21:9 band on a phone is a hundred pixels tall. Bands
     that carry a subject at the edge of the frame declare a tall ratio here
     instead. */
  @media (max-width: 899.98px) {
    .band {
      aspect-ratio: var(--band-ratio-narrow, var(--band-ratio));
    }
  }

  .band__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Only ever rendered with a quote. Warm brown rather than a neutral wash —
     the same reasoning as the hero scrim: grey turns these frames muddy. */
  .band__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image:
      radial-gradient(
        110% 75% at 50% 50%,
        rgb(var(--shade-rgb) / 0.42) 30%,
        rgb(var(--shade-rgb) / 0.58) 100%
      ),
      linear-gradient(
        180deg,
        rgb(var(--shade-rgb) / 0.34) 0%,
        rgb(var(--shade-rgb) / 0.2) 45%,
        rgb(var(--shade-rgb) / 0.46) 100%
      );
  }

  .band__caption {
    position: relative;
    z-index: 2;
    padding: clamp(3rem, 9vw, 6rem) clamp(1.5rem, 8vw, 6rem);
    text-align: center;
    text-wrap: balance;
  }

  .band__quote {
    max-width: 24ch;
    margin: 0 auto;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4.4vw, 2.9rem);
    line-height: 1.2;
    text-shadow: 0 2px 24px rgb(var(--shade-deep-rgb) / 0.35);
  }

  /* One of exactly two places the handwriting is allowed. The floor of the
     clamp is 1.15rem — 18.4px — because below roughly 18px this face stops
     being legible for the older half of this guest list. */
  .band__attribution {
    margin-top: clamp(1rem, 2.4vw, 1.5rem);
    font-family: var(--font-script);
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.4;
    color: rgb(var(--shell-rgb) / 0.95);
  }
</style>
