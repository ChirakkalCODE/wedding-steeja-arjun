---
import { WEDDING_DATE_LABEL } from '../data/wedding';

/** "Sunday, 6 September 2026" -> "6 September 2026" — the weekday is already
    on the page three times above. */
const dateOnly = WEDDING_DATE_LABEL.replace(/^[^,]+,\s*/, '');
---

<footer class="footer">
  <div class="footer__inner" data-reveal>
    <p class="footer__mark">Steeja &amp; Arjun</p>
    <p class="footer__meta">{dateOnly} &middot; Kerala, India</p>
    <p class="footer__credit">Photos by Eden Park Weddings</p>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-shell);
  }

  .footer__inner {
    max-width: 52rem;
    margin-inline: auto;
    /* No section padding of its own — a hairline and room to breathe. */
    padding: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 6vw, 3rem) clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--color-ochre);
    text-align: center;
  }

  .footer__mark {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2rem);
    line-height: 1.2;
    color: var(--color-ink);
  }

  .footer__meta {
    margin-top: 0.65rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .footer__credit {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
</style>
