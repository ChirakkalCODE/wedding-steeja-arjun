---
import { Picture } from 'astro:assets';
// Derived 4:5 master, not the 5760x8640 original — Astro copies an imported
// original into `dist/` alongside its transforms. See scripts/prepare-media.mjs.
import storyPhoto from '../assets/photos/EPW00926-4x5.jpg';

/**
 * Placeholder wording, to be replaced with the couple's own. Kept in one place
 * so swapping it is an edit to this constant and nothing else.
 */
export const STORY_COPY = {
  paragraphs: [
    "Steeja and Arjun found love in each other's hearts and a home in each other's souls. What started as a chance encounter grew into a life of laughter, small adventures and a lot of ordinary days made better by the other person.",
    "On 6 September 2026 they begin their forever in Kerala — and the only thing missing is the people who got them here. That's you.",
  ],
  quote: "We're so grateful to celebrate this unforgettable day with you.",
  signature: 'Steeja & Arjun',
};
---

<section class="story" id="story" aria-labelledby="story-title">
  <div class="story__inner">
    <!-- First in the DOM so the stacked phone layout leads with the photo,
         without needing an order override. -->
    <figure class="story__media" data-reveal>
      {/* `sizes`: above 900px the photo column settles at ~480px. Below it the
          section's own padding takes a big bite — 56px a side on a 320px phone —
          so the image is nowhere near full width, and declaring that honestly
          drops a 412px phone from the 1400w candidate to the 640w one. */}
      <Picture
        class="story__photo"
        src={storyPhoto}
        formats={['avif', 'webp']}
        widths={[640, 960, 1400, 1920]}
        sizes="(min-width: 900px) 30rem, (min-width: 700px) 84vw, 72vw"
        alt="Steeja and Arjun laughing in a close embrace, lit warmly against the dark."
        loading="lazy"
        decoding="async"
      />
      <figcaption class="story__caption">Photo: Eden Park Weddings</figcaption>
    </figure>

    <div class="story__text" data-reveal="2">
      <p class="story__eyebrow">Our story</p>

      <h2 class="story__title" id="story-title">A chance meeting, and then everything</h2>

      {STORY_COPY.paragraphs.map((text) => <p class="story__paragraph">{text}</p>)}

      <blockquote class="story__quote">
        <p class="story__quote-text">{STORY_COPY.quote}</p>
        <footer class="story__signature">{STORY_COPY.signature}</footer>
      </blockquote>
    </div>
  </div>
</section>

<style>
  .story {
    background-color: var(--color-shell);
  }

  .story__inner {
    max-width: 1240px;
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 6.5rem);
    display: grid;
    gap: clamp(2.25rem, 5vw, 4rem);
  }

  @media (min-width: 900px) {
    .story__inner {
      /* `minmax(0, …)` so a long word in the prose cannot widen its column. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
    }
  }

  .story__media {
    margin: 0;
  }

  .story__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .story__caption {
    margin-top: 0.85rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .story__eyebrow {
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .story__title {
    margin-top: clamp(0.75rem, 1.6vw, 1.1rem);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    line-height: 1.05;
    color: var(--color-ink);
  }

  .story__paragraph {
    /* The brief's measure. Sits below the column width on a phone, so it only
       bites on wide screens — which is the point of it. */
    max-width: 56ch;
    margin-top: clamp(1.25rem, 2.4vw, 1.75rem);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .story__quote {
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    border-left: 2px solid var(--color-ochre);
    padding-left: 1.25rem;
  }

  .story__quote-text {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    line-height: 1.3;
    color: var(--color-ink);
  }

  .story__signature {
    margin-top: 0.9rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.6;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
</style>
