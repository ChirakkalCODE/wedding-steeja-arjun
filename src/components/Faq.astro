---
import { FAQ } from '../data/faq';
---

<section class="faq" id="faq" aria-labelledby="faq-title">
  <div class="faq__inner">
    <p class="faq__eyebrow" data-reveal>Good to know</p>
    <h2 class="faq__title" id="faq-title" data-reveal>Questions &amp; answers</h2>
    <p class="faq__intro" data-reveal="2">Have a question? You may find the answer here.</p>

    <div class="faq__list" data-reveal="2">
      {
        FAQ.map((item) => (
          // Native disclosure: open and close cost no JavaScript, and the
          // keyboard behaviour is the platform's rather than ours.
          // No `name` attribute: that would make the group exclusive, closing
          // one answer as another opens. Not asked for, and it stops a reader
          // comparing two answers side by side.
          <details class="faq__item" id={`faq-${item.id}`}>
            <summary class="faq__summary">
              <span class="faq__question">{item.question}</span>
              <span class="faq__marker" aria-hidden="true" />
            </summary>
            {/* Trusted, repo-authored markup — see the note in src/data/faq.ts. */}
            <div class="faq__answer" set:html={item.answer} />
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background-color: var(--color-shell);
  }

  .faq__inner {
    /* Reading text: the measure stays narrow even though the page is wide. */
    max-width: 46rem;
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 6.5rem);
  }

  .faq__eyebrow {
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .faq__title {
    margin-top: clamp(0.75rem, 1.6vw, 1.1rem);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    line-height: 1.05;
    color: var(--color-ink);
  }

  .faq__intro {
    margin-top: clamp(0.9rem, 2vw, 1.25rem);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .faq__list {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  /* Hairlines only — no boxes, no cards, no shadows. */
  .faq__item {
    border-top: 1px solid rgb(var(--ink-rgb) / 0.12);
  }

  .faq__item:last-child {
    border-bottom: 1px solid rgb(var(--ink-rgb) / 0.12);
  }

  .faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
    cursor: pointer;
    /* Both are needed: the standard property and the WebKit pseudo-element. */
    list-style: none;
  }

  .faq__summary::-webkit-details-marker {
    display: none;
  }

  .faq__question {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-ink);
  }

  /* Two 1px ochre bars; the upright one turns and fades as the item opens. */
  .faq__marker {
    position: relative;
    flex: none;
    width: 0.85rem;
    height: 0.85rem;
  }

  .faq__marker::before,
  .faq__marker::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background-color: var(--color-ochre);
  }

  .faq__marker::before {
    width: 100%;
    height: 1px;
  }

  .faq__marker::after {
    width: 1px;
    height: 100%;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .faq__item[open] .faq__marker::after {
    transform: rotate(90deg);
    opacity: 0;
  }

  .faq__answer {
    max-width: 56ch;
    padding-bottom: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .faq__answer :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--color-ochre);
    text-underline-offset: 4px;
  }

  /*
   * Smooth height, in CSS rather than script. `interpolate-size` lets `height`
   * animate to and from `auto`, and `::details-content` is the box to animate.
   * Scoped to this section rather than :root so nothing else on the page
   * changes behaviour. Browsers without it keep the native instant snap, which
   * is a perfectly good outcome.
   */
  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      .faq {
        interpolate-size: allow-keywords;
      }

      .faq__item::details-content {
        height: 0;
        overflow: hidden;
        transition:
          height 0.28s ease,
          content-visibility 0.28s allow-discrete;
      }

      .faq__item[open]::details-content {
        height: auto;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__marker::after {
      transition: none;
    }
  }
</style>
