---
import {
  heroMedia,
  PHONE_MEDIA,
  PHONE_SIZES,
  WIDE_MEDIA,
  WIDE_SIZES,
} from '../lib/hero-media';

const media = await heroMedia();

const alt =
  'Steeja and Arjun sitting together on a ledge in front of a weathered ochre wall painted with a large white bird.';
---

<section class="hero" aria-labelledby="couple">
  {/* Art-directed by hand: `<Picture>` emits no `media`, so it cannot switch
      crops. Same astro:assets pipeline, same formats and widths. Order matters —
      the browser takes the first `<source>` whose media and type both match, so
      the phone crop is offered in all three formats before the wide frame. */}
  <picture class="hero__media">
    <source
      type="image/avif"
      media={PHONE_MEDIA}
      srcset={media.phone.avif.srcset}
      sizes={PHONE_SIZES}
    />
    <source
      type="image/webp"
      media={PHONE_MEDIA}
      srcset={media.phone.webp.srcset}
      sizes={PHONE_SIZES}
    />
    <source
      type="image/jpeg"
      media={PHONE_MEDIA}
      srcset={media.phone.jpeg.srcset}
      sizes={PHONE_SIZES}
    />
    <source
      type="image/avif"
      media={WIDE_MEDIA}
      srcset={media.wide.avif.srcset}
      sizes={WIDE_SIZES}
    />
    <source
      type="image/webp"
      media={WIDE_MEDIA}
      srcset={media.wide.webp.srcset}
      sizes={WIDE_SIZES}
    />
    <img
      class="hero__photo"
      src={media.fallback.src}
      srcset={media.wide.jpeg.srcset}
      sizes={WIDE_SIZES}
      width={media.fallback.width}
      height={media.fallback.height}
      alt={alt}
      loading="eager"
      fetchpriority="high"
    />
  </picture>

  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__frame">
    <p class="hero__eyebrow rise">Together with their families</p>

    <h1 class="hero__names rise" id="couple">
      <span>Steeja</span>
      <span class="hero__amp">&amp;</span>
      <span>Arjun</span>
    </h1>

    <div class="hero__rule rise rise--2" aria-hidden="true"></div>

    <p class="hero__when rise rise--2">Sunday, 6 September 2026</p>
    <p class="hero__where rise rise--2">
      Akaparambu &amp; Nedumbassery &middot; Kerala, India
    </p>

    <a class="hero__cta rise rise--3" href="#rsvp">Let us know you&rsquo;re coming</a>

    <p class="hero__by rise rise--3">Kindly reply by 20 August 2026</p>
  </div>

  <p class="hero__scroll rise rise--3" aria-hidden="true">Scroll</p>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    /* `1fr` resolves to minmax(auto, 1fr): the frame fills the viewport, but on
       a very short screen it grows past it rather than clipping the names. */
    grid-template-rows: 1fr;
    /* An implicit `auto` column is sized to its max-content — the longest
       unwrapped line — and overflows the viewport instead of letting the text
       wrap. `minmax(0, 1fr)` caps it at the container width. */
    grid-template-columns: minmax(0, 1fr);
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    /* Behind the photo for the few frames before it decodes — a warm dark, not
       a white flash. */
    background-color: var(--color-ink);
    color: var(--color-shell);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image:
      /* The inner stop is 0.38 rather than fully transparent. The brief's
         value left the centre of the scrim clear — which is exactly where the
         content sits, and on this photograph exactly where the sunlit ochre
         wall is. Measured over the real composited pixels, the type landed at
         2.4-3.4:1 where WCAG asks 4.5:1 (see the note in README). This is the
         smallest change that clears the threshold at every viewport from
         320px to 2560px; the gradient's geometry and outer stop are the
         brief's, untouched. */
      radial-gradient(
        120% 80% at 50% 45%,
        rgb(var(--shade-rgb) / 0.38) 30%,
        rgb(var(--shade-rgb) / 0.45) 100%
      ),
      linear-gradient(
        180deg,
        rgb(var(--shade-rgb) / 0.52) 0%,
        rgb(var(--shade-rgb) / 0.12) 38%,
        rgb(var(--shade-rgb) / 0.72) 100%
      );
  }

  /* -- invitation-card frame ---------------------------------------------- */

  .hero__frame {
    position: relative;
    z-index: 2;
    display: grid;
    /* Same max-content trap as `.hero` above — without this, "Akaparambu &
       Nedumbassery · Kerala, India" runs off the side of a phone instead of
       wrapping. */
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    /* Deliberately NOT `justify-items: center`: that would re-introduce the
       same problem per row. The rows stretch and the text is centred inside
       them; the two items that must hug their content opt out below. */
    --pad-y: clamp(3rem, 9vw, 5.5rem);
    margin: var(--frame-inset);
    padding: var(--pad-y) clamp(1.5rem, 6vw, 4.5rem);
    border: 1px solid rgb(var(--shell-rgb) / 0.42);
    text-align: center;
    text-wrap: balance;
  }

  /* Short viewports — 720p laptops, and small phones in the 568px-tall class.
     The padding above is driven by viewport *width*, so on a screen that is
     short for its width it pushes the frame's bottom edge past the fold. */
  @media (min-width: 900px) and (max-height: 860px), (max-height: 640px) {
    .hero__frame {
      --pad-y: clamp(1.25rem, 3.5svh, 5.5rem);
      /* Extra below keeps the compressed content clear of the Scroll label,
         which lives in the gutter rather than in the frame's flow. */
      padding-bottom: calc(var(--pad-y) + 1.25rem);
    }
  }

  /* The top bar is absolutely positioned over the hero, so the frame has to
     hold its own content out from under it. Only below 900px: there the bar's
     wordmark and Reply link span the same width as the centred content and a
     wrapped eyebrow runs straight into them. On wider screens the bar sits in
     the far corners and the content never reaches it. The terms mirror
     TopBar.astro's padding and the wordmark's line box. */
  @media (max-width: 899.98px) {
    .hero__frame {
      --topbar-clearance: calc(
        clamp(0.9rem, 2.2vw, 1.6rem) + clamp(1.26rem, 2.88vw, 1.62rem) + 0.85rem
      );
      padding-top: max(var(--pad-y), var(--topbar-clearance));
    }
  }

  .hero__frame::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid rgb(var(--shell-rgb) / 0.22);
    pointer-events: none;
  }

  /* -- content ------------------------------------------------------------- */

  .hero__eyebrow {
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.34em;
    /* Tracking is added after the last letter too, which pulls centred text
       off-axis by half a space; the indent puts it back. */
    text-indent: 0.34em;
    text-transform: uppercase;
    /* Secondary type sits a little closer to full shell than the brief's
       values. Over a photograph, opacity is an expensive way to buy hierarchy —
       size, tracking and weight already carry it, and every point of opacity
       given back here is a point of scrim the photograph does not have to pay
       for. Same reasoning for .hero__where, .hero__by and .hero__scroll. */
    color: rgb(var(--shell-rgb) / 0.95);
  }

  /* The vertical rhythm is capped by height as well as width — a 1280x720
     screen has plenty of the first and very little of the second. */
  .hero__names {
    margin-top: clamp(1.1rem, min(2.8vw, 4svh), 1.9rem);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 11vw, 6.5rem);
    /* Unitless, so swapping in Instrument Serif over the Georgia fallback
       cannot change the block height. */
    line-height: 0.95;
    text-shadow: 0 2px 24px rgb(var(--shade-deep-rgb) / 0.35);
  }

  .hero__names span {
    display: block;
  }

  .hero__amp {
    font-size: 0.5em;
    font-style: italic;
    line-height: 1.15;
  }

  .hero__rule {
    width: clamp(3rem, 10vw, 6rem);
    height: 1px;
    margin-top: clamp(1.6rem, min(4vw, 5svh), 2.4rem);
    margin-inline: auto;
    background-image: linear-gradient(
      90deg,
      rgb(var(--shell-rgb) / 0) 0%,
      rgb(var(--shell-rgb) / 0.85) 50%,
      rgb(var(--shell-rgb) / 0) 100%
    );
  }

  .hero__when {
    margin-top: clamp(1.5rem, min(3.6vw, 4.6svh), 2.1rem);
    font-size: 1rem;
    line-height: 1.5;
    letter-spacing: 0.18em;
    text-indent: 0.18em;
    text-transform: uppercase;
  }

  .hero__where {
    margin-top: 0.55rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgb(var(--shell-rgb) / 0.92);
  }

  .hero__cta {
    margin-top: clamp(1.9rem, min(4.4vw, 5.4svh), 2.6rem);
    /* Opts out of the stretched row so the pill hugs its label. */
    justify-self: center;
    max-width: 100%;
    padding: 0.95rem 1.9rem;
    border: 1px solid rgb(var(--shell-rgb) / 0.6);
    border-radius: 999px;
    background-color: rgb(var(--shell-rgb) / 0);
    color: var(--color-shell);
    font-size: 0.9rem;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    background-color: var(--color-shell);
    border-color: var(--color-shell);
    color: var(--color-ink);
  }

  .hero__by {
    margin-top: 1rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: rgb(var(--shell-rgb) / 0.88);
  }

  .hero__scroll {
    position: absolute;
    z-index: 3;
    /* Centred with left/right rather than a translate, so the entrance
       animation owns `transform` outright. */
    left: 0;
    right: 0;
    bottom: calc(var(--frame-inset) + clamp(1rem, 2.6vw, 1.75rem));
    font-size: 0.65rem;
    line-height: 1;
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    text-transform: uppercase;
    text-align: center;
    color: rgb(var(--shell-rgb) / 0.85);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cta {
      transition: none;
    }
  }
</style>
