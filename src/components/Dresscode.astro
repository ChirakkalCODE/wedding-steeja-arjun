---
import { AVOID, GROUPS } from '../data/dresscode';

/**
 * Flat, single-weight line silhouettes on a 240x320 canvas. Drawn here rather
 * than pulled from an icon set so the line weight and proportions match the
 * rest of the page; they scale fluidly with the panel.
 */
const ILLUSTRATION: Record<string, { alt: string; paths: string[] }> = {
  ladies: {
    alt: 'Line drawing of a long gown',
    paths: [
      // Bodice, then an A-line skirt to the floor.
      'M98 78C106 70 134 70 142 78L138 148L186 282C150 296 90 296 54 282L102 148Z',
      'M104 78L99 52', // shoulder straps, splaying out rather than meeting
      'M136 78L141 52',
      'M102 148H138', // waist seam
    ],
  },
  aunties: {
    alt: 'Line drawing of a draped saree',
    paths: [
      // One draped garment from bust to floor rather than a separate blouse —
      // a second outline there reads as a box the pallu crosses, not a drape.
      'M100 80C110 74 130 74 140 80L146 126L176 286C140 297 100 297 64 286L94 126Z',
      'M94 126H146', // waist
      // Pallu: a ribbon from the left shoulder, across the body, falling right.
      'M102 80C108 106 126 130 150 148C157 189 161 240 165 288L147 290C143 242 139 194 131 160C111 144 94 118 89 86Z',
      'M120 132L118 290', // pleats
    ],
  },
  gentlemen: {
    alt: 'Line drawing of a two-piece suit',
    paths: [
      // Jacket, cut away to a V at the top button.
      'M82 76C88 64 96 58 106 58L120 104L134 58C144 58 152 64 158 76L152 190H88Z',
      // Shirt showing through the V.
      'M108 60L120 100L132 60Z',
      'M106 58L96 92', // lapel edges
      'M134 58L144 92',
      'M120 104V190', // jacket opening below the button
      // Trousers.
      'M88 190L84 296H110L119 218L128 296H154L150 190Z',
    ],
  },
};
---

<section class="dress" id="dresscode" aria-labelledby="dress-title">
  <div class="dress__inner">
    <p class="dress__eyebrow" data-reveal>What to wear</p>
    <h2 class="dress__title" id="dress-title" data-reveal>Dressed in peach and beige</h2>

    <p class="dress__intro" data-reveal="2">
      We&rsquo;d love everyone to match the day. Here&rsquo;s what we have in mind &mdash;
      and thank you for playing along.
    </p>

    <div class="dress__group" data-reveal="2">
      <h3 class="sr-only" id="dress-group-label">Choose a guest group</h3>

      {/* Real radios, visually hidden but focusable. Switching groups is CSS
          only — the sibling selectors below do the work, so the section is
          fully usable with JavaScript turned off. */}
      {
        GROUPS.map((group, i) => (
          <input
            class="dress__radio"
            type="radio"
            name="dresscode"
            id={`dg-${group.id}`}
            checked={i === 0}
            aria-label={`${group.label} — ${group.garment.toLowerCase()}`}
          />
        ))
      }

      <div class="dress__pills">
        {
          GROUPS.map((group) => (
            <label class="dress__pill" for={`dg-${group.id}`}>
              {group.label}
            </label>
          ))
        }
      </div>

      <div class="dress__panels">
        {
          GROUPS.map((group) => (
            <div class="dress__panel" style={`--illus: ${group.palette[2]}`}>
              <figure class="dress__figure">
                <svg
                  class="dress__svg"
                  viewBox="0 0 240 320"
                  role="img"
                  aria-label={ILLUSTRATION[group.id]?.alt}
                >
                  {ILLUSTRATION[group.id]?.paths.map((d) => <path d={d} />)}
                </svg>
              </figure>

              <div class="dress__palette">
                <p class="dress__garment">{group.garment}</p>

                {/* Hidden until the script confirms the Clipboard API exists —
                    an instruction for a capability the browser lacks is as
                    broken as a dead button. */}
                <p class="dress__hint" data-copy-hint hidden>
                  Tap a colour to copy its code &mdash; helpful if you&rsquo;re having
                  something tailored.
                </p>

                <ul class="dress__swatches">
                  {
                    group.palette.map((hex) => (
                      <li class="dress__swatch-cell">
                        {/* Inert by default; upgraded to a real button below. */}
                        <span class="dress__swatch" data-hex={hex}>
                          <span class="dress__chip" style={`--chip: ${hex}`} />
                          <span class="dress__hex">{hex}</span>
                        </span>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          ))
        }
      </div>

      <p class="sr-only" role="status" data-copy-status></p>
    </div>

    <div class="dress__avoid" data-reveal="3">
      <h3 class="dress__avoid-title">Please avoid</h3>

      <ul class="dress__swatches dress__swatches--avoid">
        {
          AVOID.map((colour) => (
            <li class="dress__swatch-cell">
              <span class="dress__swatch dress__swatch--avoid">
                <span class="dress__chip dress__chip--avoid" style={`--chip: ${colour.hex}`} />
                <span class="dress__hex">{colour.name}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <p class="dress__avoid-note">
        We kindly ask our female guests to avoid white and cream &mdash; those are
        reserved for the bride.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.getElementById('dresscode');
    if (!section) return;
    if (!navigator.clipboard || !navigator.clipboard.writeText) return;

    var hints = section.querySelectorAll('[data-copy-hint]');
    for (var h = 0; h < hints.length; h++) hints[h].hidden = false;

    var status = section.querySelector('[data-copy-status]');
    var swatches = section.querySelectorAll('.dress__swatch[data-hex]');

    for (var i = 0; i < swatches.length; i++) {
      (function (span) {
        var hex = span.getAttribute('data-hex');

        // Swap the inert span for a real button, so focus, Enter and Space all
        // behave without re-implementing any of them.
        var button = document.createElement('button');
        button.type = 'button';
        button.className = span.className + ' dress__swatch--copy';
        button.setAttribute('data-hex', hex);
        button.setAttribute('aria-label', 'Copy colour code ' + hex);
        button.innerHTML = span.innerHTML;
        span.replaceWith(button);

        var label = button.querySelector('.dress__hex');
        var revert;

        button.addEventListener('click', function () {
          navigator.clipboard.writeText(hex).then(
            function () {
              label.textContent = 'Copied';
              if (status) status.textContent = hex + ' copied to the clipboard.';
              clearTimeout(revert);
              revert = setTimeout(function () {
                label.textContent = hex;
              }, 1600);
            },
            function () {
              if (status) status.textContent = 'Could not copy ' + hex + '.';
            },
          );
        });
      })(swatches[i]);
    }
  })();
</script>

<style>
  .dress {
    background-color: var(--color-shell);
  }

  .dress__inner {
    max-width: 1240px;
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 6.5rem);
  }

  .dress__eyebrow {
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .dress__title {
    margin-top: clamp(0.75rem, 1.6vw, 1.1rem);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    line-height: 1.05;
    color: var(--color-ink);
  }

  .dress__intro {
    max-width: 56ch;
    margin-top: clamp(1rem, 2.2vw, 1.5rem);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* -- group selector ------------------------------------------------------ */

  .dress__group {
    margin-top: clamp(2.25rem, 5vw, 3.25rem);
  }

  .dress__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    border: 0;
  }

  .dress__pills {
    display: flex;
    flex-wrap: wrap; /* two rows on a phone, never a sideways scroll */
    gap: 0.6rem;
  }

  .dress__pill {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border: 1px solid var(--color-muted);
    border-radius: 999px;
    color: var(--color-ink);
    font-size: 0.85rem;
    line-height: 1.3;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .dress__panel {
    display: none;
  }

  /*
   * The whole selector is CSS. Enumerated by index rather than by id so a
   * fourth group (children, currently commented out in the data) needs no
   * change here; the unused fourth rule costs a few dozen bytes.
   */
  .dress__radio:nth-of-type(1):checked ~ .dress__pills .dress__pill:nth-child(1),
  .dress__radio:nth-of-type(2):checked ~ .dress__pills .dress__pill:nth-child(2),
  .dress__radio:nth-of-type(3):checked ~ .dress__pills .dress__pill:nth-child(3),
  .dress__radio:nth-of-type(4):checked ~ .dress__pills .dress__pill:nth-child(4) {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-shell);
  }

  /* The radio is off-screen, so its focus ring has to be drawn on the pill. */
  .dress__radio:nth-of-type(1):focus-visible ~ .dress__pills .dress__pill:nth-child(1),
  .dress__radio:nth-of-type(2):focus-visible ~ .dress__pills .dress__pill:nth-child(2),
  .dress__radio:nth-of-type(3):focus-visible ~ .dress__pills .dress__pill:nth-child(3),
  .dress__radio:nth-of-type(4):focus-visible ~ .dress__pills .dress__pill:nth-child(4) {
    outline: 2.5px solid var(--color-ochre);
    outline-offset: 3px;
  }

  .dress__radio:nth-of-type(1):checked ~ .dress__panels .dress__panel:nth-child(1),
  .dress__radio:nth-of-type(2):checked ~ .dress__panels .dress__panel:nth-child(2),
  .dress__radio:nth-of-type(3):checked ~ .dress__panels .dress__panel:nth-child(3),
  .dress__radio:nth-of-type(4):checked ~ .dress__panels .dress__panel:nth-child(4) {
    display: grid;
  }

  .dress__panels {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .dress__panel {
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 760px) {
    .dress__panel {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr);
    }
  }

  /* -- illustration -------------------------------------------------------- */

  .dress__figure {
    margin: 0;
  }

  .dress__svg {
    display: block;
    width: 100%;
    max-width: 15rem;
    height: auto;
    margin-inline: auto;
  }

  .dress__svg path {
    fill: var(--illus);
    fill-opacity: 0.22;
    stroke: rgb(var(--ink-rgb) / 0.8);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* -- palette ------------------------------------------------------------- */

  .dress__garment {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    line-height: 1.2;
    color: var(--color-ink);
  }

  .dress__hint {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .dress__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 2vw, 1.1rem);
    margin: clamp(1rem, 2.2vw, 1.4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .dress__swatch {
    display: block;
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    text-align: center;
  }

  .dress__swatch--copy {
    cursor: pointer;
  }

  .dress__chip {
    display: block;
    width: clamp(64px, 14vw, 84px);
    height: clamp(64px, 14vw, 84px);
    border: 1px solid var(--color-ochre);
    background-color: var(--chip);
  }

  .dress__hex {
    display: block;
    margin-top: 0.5rem;
    /* On shell, never on the swatch — some of these are far too light to
       carry text. */
    font-size: 0.72rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  /* -- please avoid -------------------------------------------------------- */

  .dress__avoid {
    margin-top: clamp(2.5rem, 5.5vw, 4rem);
    padding-top: clamp(2rem, 4.5vw, 3rem);
    border-top: 1px solid var(--color-ochre);
  }

  .dress__avoid-title {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .dress__chip--avoid {
    border-color: var(--color-muted);
    /* A hairline struck corner to corner. */
    background-image: linear-gradient(
      to top right,
      transparent calc(50% - 0.5px),
      var(--color-muted) calc(50% - 0.5px),
      var(--color-muted) calc(50% + 0.5px),
      transparent calc(50% + 0.5px)
    );
  }

  .dress__avoid-note {
    max-width: 56ch;
    margin-top: clamp(1.1rem, 2.4vw, 1.5rem);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .dress__pill {
      transition: none;
    }
  }
</style>
