---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Derived 1920px masters, not the originals — see scripts/prepare-media.mjs.
import epk03533 from '../assets/photos/gallery/EPK03533.jpg';
import epk03516 from '../assets/photos/gallery/EPK03516.jpg';
import epk03505 from '../assets/photos/gallery/EPK03505.jpg';

/**
 * The black and white frames, side by side, at whatever shape they were shot.
 *
 * These photographs were losing to the page. A black and white frame on a warm
 * paper shell reads as a hole in the paper; the block inverts to ink so they
 * are surrounded by their own tonal range and the shell stops competing. It is
 * the one dark block on the page and that is what makes it a pause rather than
 * a section.
 *
 * Nothing is cropped here. Every other photograph on this page is a slice of a
 * frame chosen by an object-position; this strip is the opposite of that — each
 * one is pinned by height and keeps its own width, so a portrait sits narrow
 * beside a landscape and the row is uneven on purpose.
 *
 * The mechanism is the platform's: `overflow-x: auto` with
 * `scroll-snap-type: x mandatory`. Touch swipe, trackpad, and — because the
 * track carries `tabindex="0"` — the arrow keys all come free and all keep
 * working with JavaScript turned off. The script adds exactly two things that
 * the platform does not give a scroll container: click-drag with a mouse, and
 * the two chevrons, which are only rendered once it has loaded because a
 * control that cannot do anything should not be painted.
 *
 * Adding a photograph later is one line in FRAMES.
 */
type Frame = { src: ImageMetadata; alt: string };

const FRAMES: readonly Frame[] = [
  {
    src: epk03533,
    alt: 'Black and white: Arjun throws a fist into the air mid-laugh while Steeja grins beside him.',
  },
  {
    src: epk03516,
    alt: 'Black and white close-up of the two of them in the dark, her head tipped back mid-laugh against his shoulder, her hand resting on his chest.',
  },
  {
    src: epk03505,
    alt: 'Black and white: a street lamp burning above a narrow lane at night, with Steeja and Arjun standing close together beneath it, foreheads almost touching.',
  },
];
---

<section class="strip" aria-labelledby="strip-title">
  <p class="strip__line" id="strip-title">the quiet moments</p>

  <div class="strip__frame">
    {/* Focusable, so the arrow keys scroll it — which is the platform's own
        behaviour for a scroll container and needs a name to go with it. */}
    <div
      class="strip__track"
      data-strip
      tabindex="0"
      role="group"
      aria-label="Black and white photographs, scroll sideways"
    >
      {
        FRAMES.map((frame) => (
          <figure class="strip__item">
            {/* Pinned by height, natural width. `sizes` is generous because the
                width depends on the frame's own ratio at 60svh, which CSS knows
                and the build does not. */}
            <Picture
              class="strip__img"
              src={frame.src}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200]}
              width={1200}
              sizes="(min-width: 900px) 46vw, 82vw"
              alt={frame.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))
      }
    </div>

    <button class="strip__chev strip__chev--prev" type="button" data-prev aria-label="Previous photo">
      &#8249;
    </button>
    <button class="strip__chev strip__chev--next" type="button" data-next aria-label="Next photo">
      &#8250;
    </button>
  </div>
</section>

<script is:inline>
(function(){
var s=document.querySelector('[data-strip]');if(!s||!s.scrollBy)return;
var f=s.parentNode;
function fit(){f.classList.toggle('strip__frame--js',s.scrollWidth>s.clientWidth+4)}
fit();addEventListener('resize',fit,{passive:true});
var rm=matchMedia('(prefers-reduced-motion: reduce)');
function go(d){s.scrollBy({left:d*s.clientWidth*0.7,behavior:rm.matches?'auto':'smooth'})}
f.querySelector('[data-prev]').onclick=function(){go(-1)};
f.querySelector('[data-next]').onclick=function(){go(1)};
var down=0,x0=0,l0=0;
s.addEventListener('pointerdown',function(e){if(e.pointerType!=='mouse'||s.scrollWidth<=s.clientWidth)return;
down=1;x0=e.clientX;l0=s.scrollLeft;f.classList.add('strip__frame--drag');s.setPointerCapture(e.pointerId)});
s.addEventListener('pointermove',function(e){if(!down)return;e.preventDefault();s.scrollLeft=l0-(e.clientX-x0)});
s.addEventListener('pointerup',function(){down=0;f.classList.remove('strip__frame--drag')});
})();
</script>

<style>
  .strip {
    /* The one inverted block on the page. */
    background-color: var(--color-ink);
    color: var(--color-shell);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    /* Full-bleed by construction: a direct child of <main>, which sets no
       width. No breakout margin, so no scrollbar-width overflow. */
    width: 100%;
    overflow: hidden;
  }

  /* One of exactly three places the handwriting is allowed, and well above the
     18px floor that face needs to stay legible. */
  .strip__line {
    margin: 0 0 clamp(1.25rem, 3vw, 2rem);
    padding-inline: clamp(1.5rem, 8vw, 6rem);
    font-family: var(--font-script);
    font-size: 1.6rem;
    line-height: 1.3;
    color: var(--color-shell);
  }

  .strip__frame {
    position: relative;
  }

  .strip__track {
    display: flex;
    align-items: flex-start;
    /* `safe`, and it is the whole reason this is not plain `center`: three
       portrait frames at 60svh fit inside a wide desktop with room to spare, and
       a row of photographs shoved against the left edge with dead ink after
       them looks like a bug. Once the set overflows — on any phone, and on a
       desktop as soon as a fourth frame is added — `safe` drops back to
       flex-start, which is what keeps the first photo reachable instead of
       cutting it off past scrollLeft 0. */
    justify-content: safe center;
    gap: clamp(0.5rem, 1.5vw, 1rem);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    /* A sideways flick inside the strip must not walk the browser back a page
       or rubber-band the document. */
    overscroll-behavior-x: contain;
    /* No gutters: the photographs run into both viewport edges, so whatever is
       past the fold is cut rather than tucked away, and the strip reads as
       continuing in both directions. */
    padding-inline: 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .strip__track::-webkit-scrollbar {
    display: none;
  }

  .strip__track:focus-visible {
    outline-offset: -3px;
  }

  .strip__frame--js .strip__track {
    cursor: grab;
  }

  .strip__frame--drag .strip__track {
    cursor: grabbing;
    /* Mandatory snapping fights a scrollLeft written every pointermove; it is
       switched off for the drag and back on for the release, which is what
       makes the frame settle when the mouse comes up. */
    scroll-snap-type: none;
  }

  .strip__item {
    flex: none;
    /* The frame decides its own width from its own ratio. */
    height: 60svh;
    margin: 0;
    scroll-snap-align: center;
  }

  .strip__img {
    display: block;
    width: auto;
    height: 100%;
    /* `width`/`height` are on the element, so the intrinsic ratio is known
       before a byte of image arrives and the row is laid out once. */
  }

  /* -- chevrons ------------------------------------------------------------ */

  /* Not rendered until the script that drives them is running *and* the strip
     actually has somewhere to scroll, and never on a touch-sized screen, where
     the gesture is the control. A chevron over a strip that already fits is a
     button that does nothing. */
  .strip__chev {
    display: none;
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 2.75rem;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid rgb(var(--shell-rgb) / 0.35);
    border-radius: 999px;
    background: none;
    color: rgb(var(--shell-rgb) / 0.6);
    font: inherit;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  @media (min-width: 820px) {
    .strip__frame--js .strip__chev {
      display: block;
    }
  }

  .strip__chev--prev {
    left: clamp(0.75rem, 2vw, 1.5rem);
  }

  .strip__chev--next {
    right: clamp(0.75rem, 2vw, 1.5rem);
  }

  .strip__chev:hover,
  .strip__chev:focus-visible {
    color: var(--color-shell);
    border-color: rgb(var(--shell-rgb) / 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .strip__chev {
      transition: none;
    }
  }
</style>
