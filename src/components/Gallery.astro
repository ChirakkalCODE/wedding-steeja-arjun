---
import { Picture, getImage } from 'astro:assets';
import { PHOTOS } from '../data/gallery';

/**
 * Full-size sources for the lightbox, resolved at build time and carried on the
 * thumbnail as data attributes. The lightbox never guesses a URL and never
 * fetches anything until a photo is opened.
 */
const full = await Promise.all(
  PHOTOS.map((photo) =>
    getImage({ src: photo.src, width: 1920, format: 'webp', quality: 72 }),
  ),
);

/**
 * The preview strip: one 24px-wide rendition of every photograph, blurred to
 * nothing in CSS. It says "there are photographs here, and this is roughly what
 * they look like" for about a fifth of a kilobyte each — and it is `loading:
 * lazy` like everything else down here, so a reader who never reaches Moments
 * pays for none of it either.
 *
 * Both dimensions are given so the strip reserves its exact row before a byte
 * arrives. `getImage` would derive the height itself, but declaring it here is
 * what puts it on the element.
 */
const SEED_W = 24;

const seeds = await Promise.all(
  PHOTOS.map(async (photo) => {
    const height = Math.max(1, Math.round((SEED_W * photo.src.height) / photo.src.width));
    const image = await getImage({
      src: photo.src,
      width: SEED_W,
      height,
      format: 'webp',
      quality: 40,
    });
    return { src: image.src, width: SEED_W, height };
  }),
);

/* Injected into the button, never typed out: the grid, the lightbox, the strip
   and the count are all driven off the one array in src/data/gallery.ts. */
const COUNT = PHOTOS.length;

/* No reveal animation on these tiles, and that is deliberate rather than an
   omission. The grid is now mounted by a click, long after the page's one
   IntersectionObserver has been built and handed its targets — a `data-anim`
   here would arm a hidden state that nothing is left to lift, which is exactly
   the failure that made these photographs invisible in the first place. The
   paper-2 skeleton and the image arriving over it is the reveal. */
---

{/* "Moments" in the navigation and in the heading. The class names stay
    `gallery__*` and the data still lives in `src/data/gallery.ts` — this is what
    the section is called, not what it is. */}
<section class="gallery" id="moments" aria-labelledby="moments-title">
  <div class="gallery__inner">
    <p class="gallery__eyebrow" data-anim="head">Moments</p>
    <h2 class="gallery__title" id="moments-title" data-anim="head2">Moments we already love</h2>
  </div>

  {/* Rendered `hidden`, and un-hidden by the script in the same breath as it
      takes the grid out of the document. With no script it never appears, so
      there is never a button offering to load something that is already there. */}
  <div class="gallery__gate" data-gate hidden>
    <div class="gallery__seeds" aria-hidden="true">
      {
        seeds.map((seed) => (
          <img
            class="gallery__seed"
            src={seed.src}
            width={seed.width}
            height={seed.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        ))
      }
    </div>

    <button class="gallery__reveal" type="button" data-show>
      Show the photos ({COUNT})
    </button>
  </div>

  {/* In the document, not in a <template>. That is what makes the no-script
      path free: the grid is simply here, with native lazy loading, and the
      script's job is to take it away again — rather than the markup existing
      twice so that one copy can be for readers without JavaScript. */}
  <ul class="gallery__grid" data-grid>
    {
      PHOTOS.map((photo, i) => (
        <li
          class:list={['gallery__item', photo.orientation === 'landscape' && 'gallery__item--wide']}
        >
          {/* A figure, not a button. The script swaps it for a real <button>
              when it loads; without JavaScript this stays a plain grid rather
              than a row of controls that do nothing. */}
          <figure
            class="gallery__thumb"
            data-thumb
            data-index={i}
            data-full={full[i].src}
            data-full-w={1920}
            data-full-h={Math.round((1920 * photo.src.height) / photo.src.width)}
          >
            {/* `width` bounds the fallback as well. Without it `<Picture>` also
                emits a full 1920px copy per format that no srcset ever names —
                8.4 MB of build output nothing on the page references. */}
            <Picture
              class="gallery__img"
              src={photo.src}
              formats={['avif', 'webp']}
              widths={[400, 700, 1000]}
              width={1000}
              sizes={
                photo.orientation === 'landscape'
                  ? '(min-width: 1000px) 66vw, (min-width: 640px) 96vw, 92vw'
                  : '(min-width: 1000px) 33vw, (min-width: 640px) 48vw, 92vw'
              }
              alt={photo.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
        </li>
      ))
    }
  </ul>

  <div class="gallery__inner">
    <p class="gallery__note">More photos will be added after the wedding.</p>
  </div>

  {/* Inert until showModal() is called, so it costs nothing without JS. Using
      the native element rather than a div is the point: Escape, focus trapping
      and inertness of the page behind all come from the platform, so the script
      below only has to handle the arrows. */}
  <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
    <button type="button" class="lightbox__close" data-close aria-label="Close photo viewer">
      &times;
    </button>
    <button type="button" class="lightbox__nav lightbox__nav--prev" data-prev aria-label="Previous photo">
      &#8249;
    </button>
    <img class="lightbox__img" data-full-img alt="" />
    <button type="button" class="lightbox__nav lightbox__nav--next" data-next aria-label="Next photo">
      &#8250;
    </button>
    <p class="sr-only" role="status" data-lightbox-status></p>
  </dialog>
</section>

{/* One script, and the order inside it is load-bearing. The lightbox turns
    every thumbnail into a real <button>, so it cannot run against a grid that
    is sitting outside the document — it is a function here, called once, on
    whichever path the browser actually takes:

      · no script at all — none of this happens, the grid is already in the page
        with native lazy loading and the button was never un-hidden;
      · script, gate used — the grid comes out before layout, so not one of the
        eight images is ever requested, and both the mount and the lightbox
        happen on the click;
      · script, gate missing for any reason — the grid stays where it is and the
        lightbox is wired immediately, exactly as it was before.

    Taking the grid out is a comment node swap rather than a `remove()`: the
    comment holds the position, so the grid goes back precisely where it was
    and the note beneath it never moves.

    Six mount eagerly: two full rows on a wide screen, the first six on a
    phone — enough that the grid is populated the instant it appears, few
    enough that a reader who opens it and changes their mind has not paid for
    all of them. The rest keep `lazy` and arrive as they are approached. */}
<script is:inline>
  (function () {
    var section = document.getElementById('moments');
    if (!section) return;

    var grid = section.querySelector('[data-grid]');
    var gate = section.querySelector('[data-gate]');

    function lightbox() {
    var dialog = section.querySelector('[data-lightbox]');
    var thumbs = [].slice.call(section.querySelectorAll('[data-thumb]'));
    if (!dialog || !dialog.showModal || !thumbs.length) return;

    var img = dialog.querySelector('[data-full-img]');
    var status = dialog.querySelector('[data-lightbox-status]');
    var current = 0;
    var opener = null;
    var scrollTop = 0;
    var body = document.body;

    var n = thumbs.length;

    // Real buttons: click, Enter, Space and focus come from the platform.
    var btns = thumbs.map(function (fig, i) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = fig.className + ' gallery__thumb--live';
      b.setAttribute('aria-label', 'Open photo ' + (i + 1) + ' of ' + n);
      Object.assign(b.dataset, fig.dataset);
      b.innerHTML = fig.innerHTML;
      fig.replaceWith(b);
      b.onclick = function () { open(i); };
      return b;
    });

    function show(i) {
      current = (i + n) % n;
      var b = btns[current];
      img.src = b.dataset.full;
      img.width = b.dataset.fullW;
      img.height = b.dataset.fullH;
      img.alt = b.querySelector('img').alt;
      status.textContent = 'Photo ' + (current + 1) + ' of ' + n;
      new Image().src = btns[(current + 1) % n].dataset.full;
      new Image().src = btns[(current - 1 + n) % n].dataset.full;
    }

    function open(i) {
      opener = btns[i];
      scrollTop = window.scrollY;
      body.style.cssText = 'position:fixed;width:100%;top:' + -scrollTop + 'px';
      show(i);
      dialog.showModal();
    }

    dialog.addEventListener('close', function () {
      body.style.cssText = '';
      // scroll-behavior: smooth would animate this; the restore must be exact.
      window.scrollTo({ top: scrollTop, behavior: 'instant' });
      img.removeAttribute('src');
      if (opener) opener.focus({ preventScroll: true });
    });

    dialog.querySelector('[data-close]').onclick = function () { dialog.close(); };
    dialog.querySelector('[data-prev]').onclick = function () { show(current - 1); };
    dialog.querySelector('[data-next]').onclick = function () { show(current + 1); };

    dialog.onkeydown = function (e) {
      if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
      else return;
      e.preventDefault();
    };

    // Threshold + dominant axis, so a scroll is never read as a swipe.
    var x0, y0;
    dialog.addEventListener('touchstart', function (e) {
      x0 = e.changedTouches[0].clientX;
      y0 = e.changedTouches[0].clientY;
    }, { passive: true });
    dialog.addEventListener('touchend', function (e) {
      if (x0 == null) return;
      var dx = e.changedTouches[0].clientX - x0;
      var dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
      x0 = null;
    }, { passive: true });
    }

    var button = gate && gate.querySelector('[data-show]');

    if (!grid || !gate || !button || !grid.parentNode) {
      lightbox();
      return;
    }

    var slot = document.createComment('moments');
    grid.parentNode.replaceChild(slot, grid);
    gate.hidden = false;

    button.addEventListener('click', function () {
      var imgs = grid.querySelectorAll('img');
      for (var i = 0; i < imgs.length && i < 6; i++) imgs[i].loading = 'eager';

      slot.parentNode.replaceChild(grid, slot);
      gate.remove();
      lightbox();

      var first = section.querySelector('.gallery__thumb--live');
      if (first) first.focus({ preventScroll: true });
    });
  })();
</script>

<style>
  .gallery {
    background-color: var(--color-shell);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .gallery__inner {
    max-width: 1240px;
    margin-inline: auto;
    padding-inline: clamp(3.5rem, 8vw, 6.5rem);
  }

  .gallery__eyebrow {
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .gallery__title {
    margin-top: clamp(0.75rem, 1.6vw, 1.1rem);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    line-height: 1.05;
    color: var(--color-ink);
  }

  /* -- the gate ------------------------------------------------------------ */

  /* `hidden` is an attribute the UA stylesheet turns into `display: none`, and
     any `display` declared here would outrank it. Restated so the gate is
     really absent until the script asks for it. */
  .gallery__gate[hidden] {
    display: none;
  }

  .gallery__gate {
    margin-top: clamp(2rem, 4.5vw, 3rem);
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  .gallery__seeds {
    display: flex;
    justify-content: center;
    gap: clamp(0.35rem, 1vw, 0.6rem);
    /* Fixed row, and the seeds are pinned to it by height — so the strip holds
       its exact space from the first paint, before any of the eight tiny files
       have arrived. */
    height: clamp(4rem, 9vw, 5.5rem);
    /* Clips the blur, which otherwise bleeds past both ends of the row. */
    overflow: hidden;
  }

  .gallery__seed {
    display: block;
    width: auto;
    height: 100%;
    /* 24 pixels across, blurred past the point of being a picture. It is a
       colour and a shape, which is all a placeholder should promise. */
    filter: blur(9px);
    opacity: 0.6;
  }

  .gallery__reveal {
    display: block;
    margin: clamp(1.5rem, 3.5vw, 2.25rem) auto 0;
    padding: 0.95rem 1.9rem;
    border: 0;
    border-radius: 999px;
    background-color: var(--color-ink);
    color: var(--color-shell);
    font-family: inherit;
    font-size: 0.8rem;
    line-height: 1.2;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.25s ease;
  }

  .gallery__reveal:hover,
  .gallery__reveal:focus-visible {
    opacity: 0.86;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__reveal {
      transition: none;
    }
  }

  /* Allowed to run wider than the 1240px text column. */
  .gallery__grid {
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(0.5rem, 1.5vw, 1rem);
    max-width: 1600px;
    margin: clamp(2rem, 4.5vw, 3rem) auto 0;
    padding: 0 clamp(1rem, 4vw, 2rem);
    list-style: none;
  }

  @media (min-width: 640px) {
    .gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gallery__item--wide {
      grid-column: span 2;
    }
  }

  @media (min-width: 1000px) {
    .gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .gallery__item {
    /* Natural aspect ratio; the tile is as tall as its photograph. */
    align-self: start;
  }

  .gallery__thumb {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    /* The skeleton, and it needs no element of its own: the tile's box is
       already the photograph's exact shape — `width`/`height` are on every
       <img> and the CSS is `width: 100%; height: auto` — so this paper tone is
       simply what is behind an image that has not arrived. Nothing to add on
       load, nothing to remove, nothing that can shift. */
    background-color: var(--color-paper-2);
    overflow: hidden;
  }

  .gallery__thumb--live {
    cursor: pointer;
  }

  .gallery__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Pointer devices only — a hover state on a touchscreen is a state you get
     stuck in. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .gallery__img {
      transition:
        transform 0.4s ease,
        filter 0.4s ease;
    }

    .gallery__thumb--live:hover .gallery__img,
    .gallery__thumb--live:focus-visible .gallery__img {
      transform: scale(1.03);
      filter: brightness(1.06);
    }
  }

  .gallery__note {
    margin-top: clamp(1.5rem, 3.5vw, 2.25rem);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* -- lightbox ------------------------------------------------------------ */

  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background-color: rgb(var(--shade-rgb) / 0.94);
    overscroll-behavior: contain;
  }

  .lightbox::backdrop {
    background-color: rgb(var(--shade-rgb) / 0.94);
  }

  .lightbox[open] {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
  }

  .lightbox__img {
    grid-column: 2;
    justify-self: center;
    max-width: 100%;
    max-height: calc(100dvh - clamp(2rem, 8vw, 6rem));
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lightbox__nav,
  .lightbox__close {
    border: 1px solid rgb(var(--shell-rgb) / 0.35);
    border-radius: 999px;
    background: none;
    color: var(--color-shell);
    font: inherit;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox__nav {
    width: clamp(2.5rem, 8vw, 3.25rem);
    aspect-ratio: 1;
    font-size: 1.6rem;
  }

  .lightbox__nav--prev {
    grid-column: 1;
  }

  .lightbox__nav--next {
    grid-column: 3;
  }

  .lightbox__close {
    position: absolute;
    top: clamp(0.75rem, 3vw, 1.5rem);
    right: clamp(0.75rem, 3vw, 1.5rem);
    width: 2.75rem;
    aspect-ratio: 1;
    font-size: 1.5rem;
  }

  .lightbox__nav:hover,
  .lightbox__nav:focus-visible,
  .lightbox__close:hover,
  .lightbox__close:focus-visible {
    border-color: var(--color-shell);
  }
</style>
