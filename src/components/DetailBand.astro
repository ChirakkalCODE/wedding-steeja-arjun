---
import { Picture } from 'astro:assets';
// Derived 1920px master, never the original — see scripts/prepare-media.mjs.
import shoePhoto from '../assets/photos/gallery/EPK03357.jpg';
---

{/* A band, not a section.
    ---------------------------------------------------------------------------
    Deliberately shallow — a strip of photograph rather than something you scroll
    through. It sits immediately above Dress code so the shoes lead straight into
    the question of what to wear, and it carries no overlay, no caption and no
    heading: there is nothing to read here, which is the point.

    Separate from ImageBand rather than a variant of it. That component exists to
    put a line of type on a photograph and brings a scrim and a text slot with
    it; every one of those would have to be switched off here.

    No `data-anim`. It should already be there when you arrive rather than
    arriving after you — the same reasoning as the Story photograph, which has
    been invisible twice for exactly that reason. `loading="lazy"` because it is
    four sections down, and explicit dimensions so the strip's height is reserved
    before a byte of it lands. */}
<section class="detail-band" aria-hidden="true">
  <Picture
    class="detail-band__photo"
    src={shoePhoto}
    formats={['avif', 'webp']}
    widths={[640, 960, 1400, 1920]}
    width={1920}
    height={1280}
    sizes="100vw"
    alt=""
    loading="lazy"
    decoding="async"
  />
</section>

<style>
  .detail-band {
    /* The hairlines are the band's own edges, and they tie it to the section it
       introduces — the same ochre the dress-code panel uses for its rules. */
    border-top: 1px solid rgb(var(--ochre-rgb) / 0.25);
    border-bottom: 1px solid rgb(var(--ochre-rgb) / 0.25);
    /* A photograph is arriving into this box; the shell would flash white. */
    background-color: var(--color-ink);
    line-height: 0;
  }

  .detail-band__photo {
    display: block;
    width: 100%;
    /* Shallow on purpose. `28svh` as the floor rather than `vh` so a phone with
       its browser chrome showing does not get a band half again as tall as
       intended the moment the bar collapses. */
    height: clamp(28svh, 34vh, 320px);
    object-fit: cover;
    /* Low-left: the shoe sits in that corner of the frame and the empty concrete
       carries the right-hand side. Declared, like every other image on this
       page — the browser's 50% 50% would centre on the concrete and crop the
       shoe out of a band this shallow. */
    object-position: 38% 62%;
  }
</style>
