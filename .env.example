# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
#
# Everything here is PUBLIC BY DESIGN. The site is a static build, so anything
# prefixed `PUBLIC_` is compiled into the client bundle and is visible to anyone
# who opens devtools. Treat all three as published the moment you deploy.
#
# That is safe only because of how the database is locked down: the anon role
# has no privileges on `public.rsvps` at all, so the anon key below cannot read,
# insert, update or delete anything. It exists so the admin area can sign in.
# See supabase/migrations/0001_rsvps.sql before changing that.
#
# NEVER put these in this file or any other file in the repo:
#   SUPABASE_SERVICE_ROLE_KEY   - bypasses RLS entirely; full read/write
#   TURNSTILE_SECRET_KEY        - would let anyone forge a captcha pass
# Both live only in Supabase Edge Function secrets. See the README.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
PUBLIC_SUPABASE_URL=

# The `anon` / publishable key. Useless on its own by design.
PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (the public half of the pair).
PUBLIC_TURNSTILE_SITE_KEY=
