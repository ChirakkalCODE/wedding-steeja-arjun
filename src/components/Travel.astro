---
import {
  AIRPORT,
  EVISA_URL,
  HOTELS,
  HOTELS_PENDING,
  PRICE_BAND_LABEL,
} from '../data/travel';

/**
 * Rendered verbatim where the couple's wording will go. Kept as a visible
 * marker rather than an HTML comment: an empty paragraph under a heading looks
 * like a bug, and a marker nobody can see is a marker that ships.
 */
const COPY_TODO = '<!-- COPY TODO -->';
---

<section class="travel" id="travel" aria-labelledby="travel-title">
  <div class="travel__inner">
    <p class="travel__eyebrow" data-anim="head">Getting there</p>
    <h2 class="travel__title" id="travel-title" data-anim="head2">Travel &amp; stay</h2>

    <!-- 1. Arriving -->
    <div class="travel__block">
      <h3 class="travel__block-title">Arriving</h3>

      <p class="travel__airport">
        {AIRPORT.code} &mdash; {AIRPORT.name}
      </p>
      <p class="travel__airport-note">{AIRPORT.note}</p>

      <div class="travel__columns">
        <div>
          <h4 class="travel__sub">Flying from Switzerland</h4>
          <p class="travel__todo">{COPY_TODO}</p>
        </div>
        <div>
          <h4 class="travel__sub">Travelling within India</h4>
          <p class="travel__todo">{COPY_TODO}</p>
        </div>
      </div>
    </div>

    <!-- 2. Where to stay -->
    <div class="travel__block travel__block--ruled">
      <h3 class="travel__block-title">Where to stay</h3>

      <ul class="travel__hotels">
        {
          HOTELS.length === 0 ? (
            <li class="travel__hotel travel__hotel--pending">
              <p>{HOTELS_PENDING}</p>
            </li>
          ) : (
            HOTELS.map((hotel) => (
              <li class="travel__hotel">
                <h4 class="travel__hotel-name">{hotel.name}</h4>
                <p class="travel__hotel-area">{hotel.area}</p>
                {/* Every optional field is dropped rather than rendered blank. */}
                {hotel.distanceNote && (
                  <p class="travel__hotel-distance">{hotel.distanceNote}</p>
                )}
                <p class="travel__band">{PRICE_BAND_LABEL[hotel.priceBand]}</p>
                {(hotel.link || hotel.phone) && (
                  <p class="travel__hotel-links">
                    {hotel.link && (
                      <a href={hotel.link} target="_blank" rel="noopener noreferrer">
                        Website
                      </a>
                    )}
                    {hotel.phone && <a href={`tel:${hotel.phone.replace(/\s+/g, '')}`}>{hotel.phone}</a>}
                  </p>
                )}
              </li>
            ))
          )
        }
      </ul>
    </div>

    <!-- 3. Good to know -->
    <div class="travel__block travel__block--ruled">
      <h3 class="travel__block-title">Good to know</h3>

      <dl class="travel__facts">
        <div class="travel__fact">
          <dt class="travel__sub">Getting around</dt>
          <dd class="travel__todo">{COPY_TODO}</dd>
        </div>
        <div class="travel__fact">
          <dt class="travel__sub">Weather in September</dt>
          <dd class="travel__todo">{COPY_TODO}</dd>
        </div>
        <div class="travel__fact">
          <dt class="travel__sub">Entry requirements</dt>
          <dd>
            Please check the official
            <a href={EVISA_URL} target="_blank" rel="noopener noreferrer">
              Indian e-Visa portal
            </a>
            well ahead of travelling.
          </dd>
        </div>
      </dl>

      <p class="travel__closing">
        Questions about travel? Our brothers are happy to help &mdash; see the bottom of
        this page.
      </p>
    </div>
  </div>
</section>

<style>
  .travel {
    background-color: var(--color-shell);
  }

  .travel__inner {
    max-width: 1240px;
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 6.5rem);
  }

  .travel__eyebrow {
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .travel__title {
    margin-top: clamp(0.75rem, 1.6vw, 1.1rem);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    line-height: 1.05;
    color: var(--color-ink);
  }

  .travel__block {
    margin-top: clamp(2.25rem, 5vw, 3.25rem);
  }

  .travel__block--ruled {
    padding-top: clamp(2.25rem, 5vw, 3.25rem);
    border-top: 1px solid var(--color-ochre);
  }

  .travel__block-title {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* -- arriving ------------------------------------------------------------ */

  .travel__airport {
    margin-top: clamp(0.9rem, 2vw, 1.3rem);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.6vw, 2.5rem);
    line-height: 1.15;
    color: var(--color-ink);
  }

  .travel__airport-note {
    max-width: 56ch;
    margin-top: 0.6rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .travel__columns {
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 2.75rem);
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  @media (min-width: 760px) {
    .travel__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .travel__sub {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .travel__todo {
    margin-top: 0.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* -- where to stay ------------------------------------------------------- */

  .travel__hotels {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    margin: clamp(1.5rem, 3.5vw, 2.25rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .travel__hotels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .travel__hotels {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .travel__hotel {
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--color-muted) 45%, transparent);
  }

  /* Spans the whole grid so an empty list reads as one calm note rather than a
     lone card marooned beside two gaps. */
  .travel__hotel--pending {
    grid-column: 1 / -1;
    border-style: dashed;
    border-color: color-mix(in srgb, var(--color-ochre) 55%, transparent);
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .travel__hotel-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.2;
    color: var(--color-ink);
  }

  .travel__hotel-area,
  .travel__hotel-distance {
    margin-top: 0.3rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .travel__band {
    display: inline-block;
    margin-top: 0.9rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--color-muted);
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .travel__hotel-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
  }

  .travel__hotel-links a {
    font-size: 0.9rem;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--color-ochre);
  }

  /* -- good to know -------------------------------------------------------- */

  .travel__facts {
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 2.5rem);
    margin: clamp(1.5rem, 3.5vw, 2.25rem) 0 0;
  }

  @media (min-width: 760px) {
    .travel__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .travel__facts dd {
    margin: 0.5rem 0 0;
    max-width: 56ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .travel__facts a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--color-ochre);
  }

  .travel__closing {
    max-width: 56ch;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
</style>
