---
import {
  heroMedia,
  PHONE_MEDIA,
  PHONE_SIZES,
  WIDE_MEDIA,
  WIDE_SIZES,
} from '../lib/hero-media';

const media = await heroMedia();

const alt =
  'Steeja and Arjun sitting together on a ledge in front of a weathered ochre wall painted with a large white bird.';
---

{/* A photograph with a caption on it, and nothing else.
    ---------------------------------------------------------------------------
    The invitation used to be printed over the picture: a double-hairline frame,
    an eyebrow, the names, a rule, the date, the place, a pill and a Scroll
    label — nine elements, and a heavy wash to carry them. All of it has moved
    onto the card below, which overlaps the bottom of the photo as if laid on
    top of it, and the frame motif went with it.

    What is left here is a caption. It names the couple and the day quietly in
    the bottom-left corner, and the rest of the photograph is allowed to be a
    photograph. The scrim is a pool in that one corner now rather than a wash
    over everything.

    Still zero client JavaScript, and the <h1> is no longer here — it is on the
    card. This is a <p>. */}
<section class="hero">
  {/* Art-directed by hand: `<Picture>` emits no `media`, so it cannot switch
      crops. Same astro:assets pipeline, same formats and widths. Order matters —
      the browser takes the first `<source>` whose media and type both match, so
      the phone crop is offered in all three formats before the wide frame. */}
  <picture class="hero__media">
    <source
      type="image/avif"
      media={PHONE_MEDIA}
      srcset={media.phone.avif.srcset}
      sizes={PHONE_SIZES}
    />
    <source
      type="image/webp"
      media={PHONE_MEDIA}
      srcset={media.phone.webp.srcset}
      sizes={PHONE_SIZES}
    />
    <source
      type="image/jpeg"
      media={PHONE_MEDIA}
      srcset={media.phone.jpeg.srcset}
      sizes={PHONE_SIZES}
    />
    <source
      type="image/avif"
      media={WIDE_MEDIA}
      srcset={media.wide.avif.srcset}
      sizes={WIDE_SIZES}
    />
    <source
      type="image/webp"
      media={WIDE_MEDIA}
      srcset={media.wide.webp.srcset}
      sizes={WIDE_SIZES}
    />
    <img
      class="hero__photo"
      src={media.fallback.src}
      srcset={media.wide.jpeg.srcset}
      sizes={WIDE_SIZES}
      width={media.fallback.width}
      height={media.fallback.height}
      alt={alt}
      loading="eager"
      fetchpriority="high"
    />
  </picture>

  <div class="hero__scrim" aria-hidden="true"></div>

  {/* Bottom-left, and held clear of the card by the same `--invite-overlap` the
      card pulls itself up by — one number, so the two cannot drift into each
      other at any width. */}
  <div class="hero__caption">
    <p class="hero__title">Steeja <em>&amp;</em> Arjun</p>
    {/* The country, not the itinerary. Akaparambu and Nedumbassery are two
        different places an hour apart, and naming them here reads as an address
        rather than as a setting — the Schedule gives each one its own time. */}
    <p class="hero__meta">Sunday, 6 September 2026 · Kerala, India</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    /* Behind the photo for the few frames before it decodes — a warm dark, not
       a white flash. */
    background-color: var(--color-ink);
    color: var(--color-shell);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
  }

  /* A pool, not a wash.
     -----------------------------------------------------------------------
     The old scrim darkened the whole frame because a nine-element invitation
     was printed across the middle of it. Two quiet lines in one corner need
     far less, and the photograph is the point.

     Two layers, both doing one job each:
       · an ellipse anchored to the bottom-left corner, carrying the caption;
       · a short fade at the very top, which is only there so the monogram —
         shell-coloured, and not ours to move — keeps its footing over a bright
         part of the picture.
     Everything between the two reads as the photograph. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image:
      radial-gradient(
        78% 62% at 6% 100%,
        rgb(var(--shade-rgb) / 0.74) 0%,
        rgb(var(--shade-rgb) / 0.5) 34%,
        rgb(var(--shade-rgb) / 0.16) 62%,
        rgb(var(--shade-rgb) / 0) 82%
      ),
      linear-gradient(
        180deg,
        rgb(var(--shade-rgb) / 0.3) 0%,
        rgb(var(--shade-rgb) / 0.08) 16%,
        rgb(var(--shade-rgb) / 0) 30%
      );
  }

  /* -- caption ------------------------------------------------------------- */

  .hero__caption {
    position: absolute;
    z-index: 2;
    left: clamp(1.5rem, 6vw, 4rem);
    /* Clear of the card, by construction. `--invite-overlap` is how far the
       card is pulled up over the photo, so adding to it is the one arrangement
       that cannot collide however the card's height changes. The fallback keeps
       this honest if the hero is ever used on a page without the card. */
    bottom: calc(var(--invite-overlap, 0px) + clamp(1.75rem, 5vw, 3rem));
    /* Both axes pinned, and that is the whole of the page's CLS.
       -----------------------------------------------------------------------
       The box is anchored by `bottom`, so anything that changes its size moves
       its top edge and Chrome records a shift. Two things could:

         · width — it was `max-width`, so shrink-to-fit made the box as wide as
           its longest line, and that line's width changes when Instrument Serif
           swaps in over the Georgia fallback;
         · height — the meta line sits exactly on a wrap boundary (two lines at
           320-390px, one from 768px up), so Inter arriving over the system
           fallback can flip its line count and with it the box's height.

       The second is why the shift survived pinning the width and came back
       intermittently at 0.004: it only fires when the swap lands after first
       paint. A fixed height with the content bottom-aligned settles it — the
       rect is the same before and after the fonts arrive, whatever they do to
       the text inside it. Generous enough for three meta lines on the narrowest
       screen; on wider ones the spare height is transparent and above the type,
       where nothing can see it. */
    width: min(28rem, calc(100% - clamp(3rem, 12vw, 8rem)));
    height: 6.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    /* A caption, not a headline — the headline is on the card. */
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.15;
    text-shadow: 0 2px 18px rgb(var(--shade-deep-rgb) / 0.45);
  }

  .hero__title em {
    font-style: italic;
  }

  .hero__meta {
    margin: 0.55rem 0 0;
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1.5;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(var(--shell-rgb) / 0.8);
    text-shadow: 0 1px 14px rgb(var(--shade-deep-rgb) / 0.5);
  }
</style>
